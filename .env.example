# Stripe API Keys (Get them at https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Webhook Secret (Get it by creating a webhook endpoint in Stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# App URL (use http://localhost:3000 locally, or your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
